# =============================================================================
# Inferno (Blazetection) Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# TELEGRAM CONFIGURATION (Optional)
# =============================================================================
# Get your bot token from @BotFather on Telegram
# Instructions: https://core.telegram.org/bots#6-botfather
TELEGRAM_BOT_TOKEN=

# Get your chat ID from @userinfobot on Telegram
# Instructions: Message @userinfobot and it will reply with your chat ID
TELEGRAM_CHAT_ID=

# =============================================================================
# NOTES
# =============================================================================
# - Leave values empty if you don't want to use Telegram alerts
# - You can also configure these through the web dashboard at http://localhost:8080
# - Enable Telegram in settings.json after setting these values
# - All other settings (detection toggles, camera config) are in settings.json
# - settings.json is safe to commit (no secrets), .env is NOT (has secrets)
